# Local configuration template.
# Copy this file to .env and replace every placeholder before deploying.
# NEVER commit a real .env file or real credentials.

# A long random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=replace-with-a-long-random-string

# SQLite file used by the application. Docker overrides this with /data/app.db.
DATABASE_PATH=instance/app.db

HOST=127.0.0.1
PORT=8000

# Set to 1 only when serving over HTTPS.
SESSION_COOKIE_SECURE=0

# Set to 1 for Flask debug mode; keep 0 in the graded environment.
FLASK_DEBUG=0
