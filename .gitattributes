# Normalize line endings so the Docker entrypoint and Python sources work on
# Linux containers regardless of the developer's Windows Git settings.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf
